# Copia este fichero como .env y rellénalo. El .env nunca se sube a GitHub.

# Token del bot: Developer Portal → tu aplicación → Bot → Reset Token
DISCORD_TOKEN=

# ID de vuestro servidor de Discord. Con él, los comandos aparecen al instante.
# Discord → Ajustes → Avanzado → Modo desarrollador; luego clic derecho en el servidor → Copiar ID del servidor
GUILD_ID=

# Partidas mínimas para aparecer en /ranking
MIN_PARTIDAS_RANKING=5
